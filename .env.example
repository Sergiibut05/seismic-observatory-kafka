# Plantilla de configuración del observatorio. Copia este fichero a `.env`
# (PowerShell: Copy-Item .env.example .env) y define POSTGRES_PASSWORD.
# `.env` está ignorado por Git: nunca subas credenciales.
# Contrato completo: specs/001-esqueleto/contracts/variables-entorno.md

# --- PostgreSQL (postgres, producer, consumer, api) ---
# OBLIGATORIA, sin valor por defecto. Vacía = Compose falla nombrando la variable.
POSTGRES_PASSWORD=
POSTGRES_USER=observatorio
POSTGRES_DB=observatorio

# --- Kafka: topic y grupo ---
TOPIC_LIVE=eventos.live
TOPIC_REPLAY=eventos.replay
# Particiones al crear el topic (entero >= 1).
TOPIC_PARTITIONS=3
# Retención del topic en milisegundos (entero > 0). 604800000 = 7 días.
# `segment.ms` se acota a min(TOPIC_RETENTION_MS, 86400000).
TOPIC_RETENTION_MS=604800000
CONSUMER_GROUP=consumidor-live

# --- Reintentos con backoff y sondas de salud ---
RETRY_INITIAL_SECONDS=1
RETRY_FACTOR=2
RETRY_MAX_SECONDS=30
HEALTH_PROBE_INTERVAL_SECONDS=5
# Fallos consecutivos de la sonda (Kafka o PostgreSQL) tras los que se recrea la sesión.
PROBE_FALLOS_REINICIO=3

# --- Prueba de humo ---
# Tiempo máximo (segundos) para obtener el acuse de Kafka.
SMOKE_TIMEOUT_SECONDS=30

# --- Ingesta USGS (producer) ---
# Feed de las últimas 24 h. El productor lo consulta cada POLL_INTERVAL_SECONDS.
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=30
# Horas que se conservan las copias del GeoJSON original en data/usgs.
FEED_RETENTION_HOURS=48

# --- Registro ---
# DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# --- Histórico y reproducción (comandos sueltos, no los servicios) ---
# python -m observatorio.historico y python -m observatorio.replay.
# Dentro de Compose el directorio montado es /data/historico.
# HISTORICO_DIR=/data/historico
# HISTORICO_ANIO=2025
# REPLAY_LIMITE=40
# REPLAY_PAUSA_SECONDS=0.2

# --- Valores fijados en compose.yaml (no se leen de este fichero) ---
# Se listan como referencia; para cambiarlos hay que editar compose.yaml.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# KAFKA_BOOTSTRAP_SERVERS=kafka:19092
# CATALOGO_PATH=/catalogo/paises.geojson
# HEALTH_PORT=8081
